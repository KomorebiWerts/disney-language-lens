{
  "manifest_version": 3,
  "name": "Disney+ 双语学习字幕",
  "description": "同步显示 Disney+ 官方英中字幕，并提供语境短语释义、音标、发音和跳转防错位。",
  "version": "1.1.1",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.disneyplus.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_title": "Disney+ 双语学习字幕",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["core.js", "page-adapter.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["core.js", "dictionary-core.js", "content-ui.js"],
      "run_at": "document_start"
    }
  ]
}
