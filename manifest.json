{
  "manifest_version": 3,
  "name": "Disney+ 双语学习字幕",
  "description": "同步显示 Disney+ 官方英文与中文字幕，并提供英文单词悬停释义、音标和发音。",
  "version": "1.0.3",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.disneyplus.com/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*"
  ],
  "action": {
    "default_title": "Disney+ 双语学习字幕",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["core.js", "page-adapter.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.disneyplus.com/*"],
      "js": ["core.js", "content-ui.js"],
      "run_at": "document_start"
    }
  ]
}
